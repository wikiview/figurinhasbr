# Copie pra .env e preencha com os valores do seu projeto Supabase.
# Settings → API no painel do Supabase.

EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Para o script de seed (NÃO commitar a service_role key!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Gemini Vision (OCR) — só precisa quando ligarmos o scan automático
EXPO_PUBLIC_GEMINI_API_KEY=
